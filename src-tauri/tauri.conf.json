{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Accessible",
  "version": "0.1.3",
  "identifier": "fr.accessible.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Accessible",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "https://api.arasaac.org"],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "https://static.arasaac.org"
        ],
        "media-src": ["'self'", "blob:", "asset:", "http://asset.localhost"],
        "font-src": ["'self'", "data:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg", "app"],
    "resources": {
      "resources/lang-packs/": "lang-packs/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/lang-pack-installer.nsh",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:accessible.db"]
    }
  }
}
