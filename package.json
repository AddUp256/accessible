{
  "name": "@addup256/accessible",
  "private": false,
  "description": "Application locale pour adapter la lecture, l'ecriture, l'organisation, la communication et le travail numerique.",
  "version": "0.1.10",
  "license": "MIT",
  "homepage": "https://addup256.github.io/accessible/",
  "bugs": {
    "url": "https://github.com/AddUp256/accessible/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AddUp256/accessible.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "COMPATIBILITY.md",
    "INSTALLATION.md",
    "BUILD.md",
    "PROJECT_STATUS.md",
    "AUDIT_CODEBASE.md",
    "src",
    "src-tauri",
    "static",
    "scripts",
    "installer",
    ".github/workflows"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build:lang-packs": "npx --yes tsx scripts/export-lang-packs.ts",
    "build": "npm run build:lang-packs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:regression": "tsx scripts/regression-tests.ts",
    "smoke": "npm run check && npm run test:regression && npm run build && npm run validate:lang-packs && node scripts/smoke-validate.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "validate:lang-packs": "node scripts/validate-lang-packs.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:windows": "tauri build",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:macos": "tauri build --target aarch64-apple-darwin",
    "tauri:build:macos-intel": "tauri build --target x86_64-apple-darwin"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@fontsource/andika": "^5.2.10",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/inclusive-sans": "^5.2.8",
    "@fontsource/lexend": "^5.2.11",
    "@fontsource/readex-pro": "^5.2.11",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "jspdf": "^4.2.1",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
